# Optional. Only needed for the shared-history feature (friends' results added via your
# /quiz?for=<id> invite link).
#
# Locally, if these are unset, that feature falls back to a JSON file on disk
# (.data/shared-results.json) — no setup required for local dev or tunnel testing.
#
# On Vercel, add a KV/Redis database from the project's Storage tab (Upstash-backed) and
# connect it to this project; Vercel injects KV_REST_API_URL / KV_REST_API_TOKEN
# automatically, so you shouldn't need to set these by hand there.
#
# To test the Redis path locally instead of the file fallback, create a free database at
# https://upstash.com and paste its REST URL/token below (or use the KV_REST_API_* names).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required to enable /admin. Pick a strong, private password only you know — it gates a
# dashboard that lists every completed assessment across all visitors (not just your own).
# Without this set, /admin shows a "not configured" message instead of a login form.
ADMIN_PASSWORD=
